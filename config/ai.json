{
  "provider": "openai-compatible",
  "baseURL": "https://tpsp.dev.huawei.com/llm/qwen3.6/v1",
  "model": "qwen",
  "timeoutMs": 600000,
  "responseFormat": "json_object",
  "ignoreHTTPSErrors": true,
  "logging": {
    "enabled": true,
    "console": true,
    "file": "../.data/logs/model.jsonl",
    "maxChars": 64000
  },
  "planningLimits": {
    "inputBudget": 64000,
    "maxOutputTokens": 8192,
    "maxInterfacesPerBatch": 6
  }
}
