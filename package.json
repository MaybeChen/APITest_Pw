{
  "name": "ai-api-test-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "web": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "demo": "tsx apps/demo-app/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config apps/web/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "ai:check": "tsx apps/server/src/ai-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1",
    "re2js": "^2.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
